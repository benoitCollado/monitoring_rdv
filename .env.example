# Postgres
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=odoo_link_monitor

# Laisser vide = pas d'authentification (dev local uniquement).
# En production : une chaîne longue et aléatoire, à saisir dans l'écran de connexion du front.
API_KEY=

# Cron quotidien (désactivable pour un process one-shot)
SCHEDULER_ENABLED=true

# Vérifications HTTP
CHECK_CONCURRENCY=8
CHECK_TIMEOUT_SECONDS=15

# Origines autorisées pour le front ("*" en dev, votre domaine en prod)
CORS_ORIGINS=*

# URL de l'API vue depuis le navigateur (le nginx du front proxifie /api)
VITE_API_BASE_URL=/api
